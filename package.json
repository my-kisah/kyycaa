{
  "name": "romantic-memory-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prisma-generate-auto.cjs && next dev",
    "build": "node scripts/prisma-generate-auto.cjs && node scripts/prisma-bootstrap-auto.cjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "prisma:generate": "node scripts/prisma-generate-auto.cjs",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "build:postgres": "prisma generate --schema prisma/schema.postgres.prisma && next build",
    "prisma:generate:postgres": "prisma generate --schema prisma/schema.postgres.prisma",
    "prisma:push:postgres": "prisma db push --schema prisma/schema.postgres.prisma",
    "prisma:seed:production": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.11.0",
    "next": "^15.5.9",
    "next-auth": "^5.0.0-beta.28",
    "prisma": "^6.19.3",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "react-hook-form": "^7.73.1",
    "recharts": "^3.8.1",
    "sanitize-html": "^2.17.3",
    "slugify": "^1.6.9",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "^15.5.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
